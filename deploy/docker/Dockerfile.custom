# ============================================================
# Build a custom Crawl4AI image based on the official one,
# replacing ALL code from your GitHub fork.
#
# No local files needed — everything comes from GitHub.
#
# Usage (from any directory):
#   docker build -t crawl4ai-custom:latest \
#       -f deploy/docker/Dockerfile.custom .
# ============================================================

ARG BASE_IMAGE=docker.1ms.run/unclecode/crawl4ai:latest
FROM ${BASE_IMAGE}

USER root

# Build-time proxy (NOT persisted to image). Docker treats these as predefined
# build args: when passed via --build-arg they're auto-exported as env vars to
# all RUN commands during build, used by apt/pip/git/curl, then dropped from
# the final image — no ENV, no docker history leak.
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

# Switch apt to Aliyun mirror for faster installs in China
# Debian 12 (bookworm) slim uses deb822 format (debian.sources) by default; also handle legacy sources.list
RUN if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources; \
    fi && \
    if [ -f /etc/apt/sources.list ]; then \
        sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list; \
    fi

# Switch pip to Aliyun mirror for faster installs in China
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/ && \
    pip config set global.trusted-host mirrors.aliyun.com

# Install ss (iproute2), socat for network debugging, x11vnc for remote browser access
# + Mesa DRI/GLX/EGL 用户态驱动（容器需通过 /dev/dri 直通宿主 GPU 才有意义）：
#   - libgl1-mesa-dri 提供 iris_dri.so（Intel Gen11+，含 TS-464C2 的 Jasper Lake UHD）
#   - libglx-mesa0/libegl-mesa0 提供 GLX/EGL → Mesa 桥接
#   - mesa-utils 提供 glxinfo，便于容器内验证（DISPLAY=:99 glxinfo | grep renderer）
#
# 故意不装的：intel-media-va-driver-non-free + libva2（VAAPI 视频硬解码）
#   - neko/runtime/Dockerfile.intel 装这两个是为了 GStreamer 用 VAAPI 编码 WebRTC 推流。
#   - 我们场景是抓 HTML / 截图，不播视频、不推流，VAAPI 用不上。
#   - 边角情况：若以后启用 scan_full_page 滚动有 <video> 标签的反爬页（视频起播才解锁
#     内容），VAAPI 能省解码 CPU。届时再加 `intel-media-va-driver-non-free libva2`。
#     现在不加，避免镜像膨胀。
RUN apt-get update && apt-get install -y --no-install-recommends \
        iproute2 socat x11vnc \
        libgl1-mesa-dri libglx-mesa0 libegl-mesa0 mesa-utils \
    && rm -rf /var/lib/apt/lists/*

ARG GITHUB_REPO=https://github.com/wchy1128/crawl4ai.git
ARG GITHUB_BRANCH=main

# 1. Clone your fork
RUN git clone --depth 1 --branch ${GITHUB_BRANCH} ${GITHUB_REPO} /tmp/crawl4ai

# 2. Show current patch content
RUN echo ">>>>>>>>>> Patch commit(s):" && \
    cd /tmp/crawl4ai && git log --oneline -5 && \
    echo "<<<<<<<<<<"

# 3. Reinstall the crawl4ai library
RUN pip install --no-cache-dir /tmp/crawl4ai && \
    python -c "import crawl4ai; print('crawl4ai library OK')"

# 3.2 Pin FastAPI below 0.137. Since FastAPI 0.137, include_router() appends a
# single _IncludedRouter aggregator to app.routes instead of expanding the
# sub-router's routes. prometheus-fastapi-instrumentator (shipped by the base
# image) iterates app.routes and reads route.path, which raises
#   AttributeError: '_IncludedRouter' object has no attribute 'path'
# on every request and turns the whole API into HTTP 500. requirements.txt is
# NOT consumed by this Dockerfile (deps come from the base image), so the pin
# must live here. Drop this block once instrumentator>=8.0.0 lands in the base
# image (upstream fix released 2026-05-29).
# Explicit uninstall+install mirrors the PyJWT block above for consistency and
# guarantees stale 0.137+ files are removed regardless of how the base image
# installed fastapi (pip's auto-uninstall-on-downgrade normally suffices, but
# being explicit is safer if dist-info/RECORD is ever inconsistent).
RUN pip uninstall -y fastapi || true && \
    pip install --no-cache-dir "fastapi<0.137" && \
    python -c "import fastapi; v=tuple(int(x) for x in fastapi.__version__.split('.')[:3]); \
               assert v < (0,137,0), 'fastapi pin failed: '+fastapi.__version__; \
               print('fastapi', fastapi.__version__, 'OK (<0.137)')"

# 3. Replace all server-side code (same as official: COPY deploy/docker/* /app/)
RUN cp -r /tmp/crawl4ai/deploy/docker/* /app/ && \
    rm -rf /tmp/crawl4ai

# 4. Fix ownership — official image runs as appuser
RUN chown -R appuser:appuser /app

USER appuser
